# Environment variables for Atlas

# PostgreSQL connection URL
DATABASE_URL=postgresql://atlas:atlas_pass@localhost:5432/atlas_db

# Atlas server settings
ATLAS_HOST=0.0.0.0
ATLAS_PORT=8000
GRPC_PORT=50051

# Worker settings
HEARTBEAT_INTERVAL=5
WORKER_TIMEOUT=30
MAX_RETRIES=3

# Logging
LOG_LEVEL=info
